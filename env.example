# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# App / Segurança
NEXT_PUBLIC_APP_URL=https://www.konvexy.com.br
# OBRIGATÓRIO em produção: segredo fixo p/ assinar tokens CSRF.
# Sem ele, cada instância serverless gera um segredo próprio e os tokens quebram.
CSRF_SECRET=gere-um-hex-de-64-chars-aleatorio
# Segredo p/ rotas administrativas internas (ex.: /api/user/update-plan)
INTERNAL_API_SECRET=gere-um-segredo-forte

# Redis (rate limiting distribuído). Sem ele cai p/ memória (não recomendado em prod)
REDIS_STORAGE_REDIS_URL=redis://user:password@host:port

# Database (Optional - if using Postgres directly)
POSTGRES_URL=postgresql://user:password@host:port/database
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:port/database
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
